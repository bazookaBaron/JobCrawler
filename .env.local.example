# ---------------------------------------------------------------------------
# job-crawler — local / CI environment.  Copy to  crawler/.env.local  and set
# LOCAL_DATABASE_URL. That is the ONLY required value. NO Redis anymore.
#
# crawler/.env.local is git-ignored and auto-loaded by src/pgpipe/config.py.
# ===========================================================================


# ======================  REQUIRED  =========================================

# Supabase Postgres (free tier). Use the "Session pooler" / direct URI on
# port 5432 with sslmode=require. Supabase dashboard ->
#   Project Settings -> Database -> Connection string -> URI
#
#   postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
LOCAL_DATABASE_URL=postgresql://crawler_writer:CHANGE_ME@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require

# Least-privilege login used by the scheduled workflows (GitHub secret
# CRAWLER_DATABASE_URL). Preferred over LOCAL_DATABASE_URL for every command
# except `jobs migrate`, which needs the ADMIN/owner URI in LOCAL_DATABASE_URL.
# Create the login once (see README, "Database roles"). Never commit real values.
# CRAWLER_DATABASE_URL=postgresql://crawler_writer:CHANGE_ME@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require


# ======================  OPTIONAL (sane defaults in src/pgpipe/config.py) ===

# Dedicated Postgres schema — keeps every crawler table out of `public` so it
# never collides with the shared webapp tables. Change only if you must.
PGPIPE_SCHEMA=crawler

# Boards fetched in parallel (per-host still serialised by the politeness gate).
PGPIPE_CONCURRENCY=12

# Tech-only filter (src/pgpipe/tech_filter.py): keep engineering, ML / data
# science, applied & security research, and quant titles; drop everything else
# (sales, recruiting, FP&A/finance, collections, ...). Set to 0 to store every role.
PGPIPE_TECH_ONLY=1

# Politeness — min seconds between two hits to the SAME host. ATS API hosts
# (boards-api.greenhouse.io, api.ashbyhq.com, ...) are shared by many boards,
# so this throttles the whole provider.
PGPIPE_DELAY_ATS=0.6
PGPIPE_DELAY_OTHER=2.0

# Queue: reset 'claimed' rows older than this (minutes) at the start of a run.
PGPIPE_RECLAIM_AFTER_MIN=30

# Crawl-budget weighting. Boards on these ATS providers are claimed first for
# PGPIPE_PRIORITY_WEIGHT of each pass (0.7 = 70%); the long tail shares the
# rest. Either group takes 100% once the other drains. Blank list or weight
# 0/1 => plain FIFO.
PGPIPE_PRIORITY_MONITORS=greenhouse,workday
PGPIPE_PRIORITY_WEIGHT=0.7

# Retention. job_posting keeps only the last KEEP_DAYS days (by eff_at), open or
# closed; expired rows are remembered in crawler.seen_posting first and are not
# re-inserted. A job is closed when its board was crawled OK and it was missing,
# or when unseen for CLOSE_AFTER_HOURS (boards crawl every 12h -> 36; LinkedIn
# every 2h -> 30). CLOSED rows are deleted after MAX_AGE_DAYS or KEEP_DAYS.
PGPIPE_KEEP_DAYS=2                    # job_posting window (site shows 24h, digest ~1 day)
PGPIPE_MAX_ROWS=60000                 # safety cap: delete oldest eff_at beyond this
PGPIPE_SEEN_TTL_DAYS=45               # forget seen_posting rows unseen this long
PGPIPE_PER_COMPANY_CAP=400            # keep newest N OPEN postings per company (extras are closed)
PGPIPE_CLOSE_AFTER_HOURS=36           # close boards' jobs unseen this long
PGPIPE_CLOSE_AFTER_HOURS_LINKEDIN=30  # same, source='linkedin'
PGPIPE_MAX_AGE_DAYS=7                 # hard DELETE rows closed more than N days ago (KEEP_DAYS usually wins)


# ======================  GONE — do not set  ===============================
# REDIS_URL / UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
#   Removed. The work queue is Postgres (crawler.crawl_queue); politeness is
#   in-process. See UPSTREAM_DRIFT.md.
# TYPESENSE_* / WEB_DATABASE_URL / DATABASE_URL
#   Unused. Search is Postgres FTS (search/jobs_search.sql).
