# ---------------------------------------------------------------------------
# job-crawler — local / CI environment.  Copy to  crawler/.env.local  and set
# LOCAL_DATABASE_URL. That is the ONLY required value. NO Redis anymore.
#
# crawler/.env.local is git-ignored and auto-loaded by src/pgpipe/config.py.
# ===========================================================================


# ======================  REQUIRED  =========================================

# Supabase Postgres (free tier). Use the "Session pooler" / direct URI on
# port 5432 with sslmode=require. Supabase dashboard ->
#   Project Settings -> Database -> Connection string -> URI
#
#   postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
LOCAL_DATABASE_URL=postgresql://postgres.REDACTED_PROJECT_REF:REDACTED_DB_PASSWORD@aws-0-REDACTED-REGION.pooler.supabase.com:5432/postgres?sslmode=require


# ======================  OPTIONAL (sane defaults in src/pgpipe/config.py) ===

# Dedicated Postgres schema — keeps every crawler table out of `public` so it
# never collides with the shared webapp tables. Change only if you must.
PGPIPE_SCHEMA=crawler

# Boards fetched in parallel (per-host still serialised by the politeness gate).
PGPIPE_CONCURRENCY=12

# Tech-only filter (src/pgpipe/tech_filter.py): keep only engineering /
# applied-science / quant-dev titles, drop everything else (sales, recruiting,
# finance, collections, ...). Set to 0 to store every role.
PGPIPE_TECH_ONLY=1

# Politeness — min seconds between two hits to the SAME host. ATS API hosts
# (boards-api.greenhouse.io, api.ashbyhq.com, ...) are shared by many boards,
# so this throttles the whole provider.
PGPIPE_DELAY_ATS=0.6
PGPIPE_DELAY_OTHER=2.0

# Queue: reset 'claimed' rows older than this (minutes) at the start of a run.
PGPIPE_RECLAIM_AFTER_MIN=30

# Retention.
PGPIPE_PER_COMPANY_CAP=400     # keep newest N postings per company
PGPIPE_CLOSE_AFTER_DAYS=3      # status='closed' when unseen this long (end of each run)
PGPIPE_DELETE_AFTER_DAYS=5     # hard DELETE when unseen this long (daily workflow)


# ======================  GONE — do not set  ===============================
# REDIS_URL / UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
#   Removed. The work queue is Postgres (crawler.crawl_queue); politeness is
#   in-process. See UPSTREAM_DRIFT.md.
# TYPESENSE_* / WEB_DATABASE_URL / DATABASE_URL
#   Unused. Search is Postgres FTS (search/jobs_search.sql).
